{
  "name": "@molstar/3dprint-export-extension",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* 3D-Print Planning extension (support struts, pedestal, pillars, text embossing, and durable presets)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./_test/*": null,
    "./prism-viewer-ui": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/prism-viewer": "workspace:*",
    "@molstar/prism-ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
